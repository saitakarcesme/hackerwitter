{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/fetch_meta.mjs",
  "outputDirectory": "public",
  "cleanUrls": false,
  "rewrites": [{ "source": "/((?!data/|app\\.js|app\\.css|favicon\\.svg).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] },
    { "source": "/(app\\.js|app\\.css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ]
}
